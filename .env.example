# Shared
ASPNETCORE_ENVIRONMENT=Production
SA_PASSWORD=

# API container/listener
API_INTERNAL_PORT=8080
API_HOST_PORT=5285

# UI container/listener
UI_INTERNAL_PORT=8080
UI_HOST_PORT=5204

# API configuration (set secure values for real deployments)
API_CONNECTION_STRING=
JWT_SECRET=
JWT_ISSUER=eCommerceAPI
JWT_AUDIENCE=eCommerceUI

# Optional explicit UI -> API URL override.
# Default in compose is http://ecommerce-api:${API_INTERNAL_PORT}
UI_API_BASE_URL=

# Azure Service Bus (use a user secret or managed identity in production)
AZURE_SERVICE_BUS_ENABLED=false
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=
AZURE_SERVICE_BUS_TOPIC_NAME=order-events
OTEL_EXPORTER_OTLP_ENDPOINT=

